---
interface Props { title?: string; description?: string }
const { title, description = 'Control systems engineer moving toward robotics and AI-augmented development.' } = Astro.props;
const full = title ? `${title} | Joseph Capener` : 'Joseph Capener';
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header>
      <a class="brand" href="/">Joseph Capener</a>
      <nav aria-label="Main">
        {links.map((l) => (
          <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer>© {new Date().getFullYear()} Joseph Capener</footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #fff; --fg: #1a1a1a; --muted: #5a5a5a; --accent: #0b5cad; --rule: #e2e2e2;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #111418; --fg: #e8e8e8; --muted: #a0a6ad; --accent: #6db3f2; --rule: #2a2f36; }
  }
  * { box-sizing: border-box; }
  body { margin: 0 auto; max-width: 44rem; padding: 0 1rem; background: var(--bg); color: var(--fg);
         font: 1.0625rem/1.65 system-ui, sans-serif; }
  a { color: var(--accent); }
  header { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; justify-content: space-between;
           align-items: baseline; padding: 1.5rem 0; border-bottom: 1px solid var(--rule); }
  .brand { font-weight: 700; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 1.25rem; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a[aria-current] { color: var(--fg); font-weight: 600; }
  main { padding: 2rem 0; }
  h1 { line-height: 1.2; }
  .lead { font-size: 1.25rem; color: var(--muted); }
  ul.cards { list-style: none; padding: 0; display: grid; gap: 1rem; }
  ul.cards li { border: 1px solid var(--rule); border-radius: .5rem; padding: 1rem; }
  ul.cards h2 { margin: 0 0 .25rem; font-size: 1.1rem; }
  footer { padding: 2rem 0; border-top: 1px solid var(--rule); color: var(--muted); font-size: .9rem; }
</style>
